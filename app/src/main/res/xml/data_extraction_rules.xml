<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not copy the WebView profile store: it can contain cookies and site storage. -->
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="sharedpref" path="mangaflow_translation_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- A device migration must not carry private WebView profile contents forward. -->
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="sharedpref" path="mangaflow_translation_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
